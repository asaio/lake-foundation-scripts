{
  "Comment": "Retrieve Glue session logs for federated user with CloudTrail validation",
  "StartAt": "LookupCallerInCloudTrail",
  "States": {
    "LookupCallerInCloudTrail": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:cloudtrail:lookupEvents",
      "Parameters": {
        "LookupAttributes": [
          {
            "AttributeKey": "EventName",
            "AttributeValue": "StartExecution"
          }
        ],
        "MaxResults": 10
      },
      "ResultPath": "$.cloudtrail",
      "Next": "ValidateExecutionEvent"
    },
    "ValidateExecutionEvent": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.cloudtrail.Events[?requestParameters.name == $$.Execution.Name].userIdentity.arn",
          "IsPresent": true,
          "Next": "DistributedMapSessions"
        }
      ],
      "Default": "FailNoCaller"
    },
    "FailNoCaller": {
      "Type": "Fail",
      "Error": "CallerNotFound",
      "Cause": "No matching CloudTrail StartExecution event found for this execution."
    },
    "DistributedMapSessions": {
      "Type": "Map",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "Distributed"
        },
        "StartAt": "GetSessionTags",
        "States": {
          "GetSessionTags": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:glue:getTags",
            "Parameters": {
              "ResourceArn.$": "States.Format('arn:aws:glue:{region}:{accountId}:session/{}', sessionId)"
            },
            "ResultPath": "$.tags",
            "Next": "CheckOwnerTag"
          },
          "CheckOwnerTag": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "tags.Tags.owner",
                "StringEqualsPath": "cloudtrail.Events[?requestParameters.name == $$.Execution.Name].userIdentity.arn",
                "Next": "FetchLogStreams"
              }
            ],
            "Default": "SkipSession"
          },
          "FetchLogStreams": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:logs:describeLogStreams",
            "Parameters": {
              "LogGroupName": "/aws-glue/sessions",
              "LogStreamNamePrefix.$": "sessionId"
            },
            "ResultPath": "$.logStreams",
            "Next": "DistributedMapLogStreams"
          },
          "DistributedMapLogStreams": {
            "Type": "Map",
            "ItemProcessor": {
              "ProcessorConfig": {
                "Mode": "Distributed"
              },
              "StartAt": "FetchLogs",
              "States": {
                "FetchLogs": {
                  "Type": "Task",
                  "Resource": "arn:aws:states:::aws-sdk:logs:filterLogEvents",
                  "Parameters": {
                    "LogGroupName": "/aws-glue/sessions",
                    "LogStreamNames": [
                      "logStreamName"
                    ]
                  },
                  "ResultPath": "$.events",
                  "Next": "WriteToS3"
                },
                "WriteToS3": {
                  "Type": "Task",
                  "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
                  "Parameters": {
                    "Bucket": "my-glue-session-logs",
                    "Key.$": "States.Format('{}/{}-{}.json', cloudtrail.Events[?requestParameters.name == $$.Execution.Name].userIdentity.arn, sessionId, logStreamName)",
                    "Body.$": "events"
                  },
                  "End": true
                }
              }
            },
            "ItemsPath": "logStreams.logStreams[*].logStreamName",
            "MaxConcurrency": 20,
            "End": true
          },
          "SkipSession": {
            "Type": "Pass",
            "Result": "Skipped - not owner",
            "End": true
          }
        }
      },
      "ItemsPath": "sessionIds",
      "MaxConcurrency": 10,
      "End": true
    }
  }
}
